---
const { category } = Astro.props
---

<ul>
    {
        category.map(({ name, icon, level }) => (
            
        level == "Junior" ?
            <li>
                <span><img src={icon} alt={`Icono de ${name}`}> {name}</span>
            </li>
        : ""
        ))
    }
    <slot /> <!-- aquí va la información que recibe -->
</ul>

<style>
    ul {
        display: flex;
        flex-wrap: wrap;
        gap: 1rem 2rem;
        padding-top: .4rem;

        & li {
            font-size: .9rem;

            & span {
                display: flex;
                align-items: center;
                gap: .5rem;
            }

            & img {
                width: 25px;
            }
        }
    }
</style>