---
import { basics } from "@/data/data.json";

const { name, label, image } = basics;
---

<div class="container">
    <figure>
        <img src={image} alt={name}>
    </figure>
    
    <div class="info">
        <h1>{name}</h1>
        <h2>{label}</h2>
    </div>
</div>

<style>
    .container {
        background: linear-gradient(var(--brand-color1), var(--brand-color2));
        display: flex;
        gap: 1.5rem;
        justify-content: center;
        align-items: center;
        height: 200px;

        & figure {
            width: 150px;

            & img {
                width: 100%;
                border-radius: 50%;
            }
        }

        & h1 {
            font-size: 3rem;
            color: var(--light-bgcolor);
        }

        & h2 {
            font-weight: 500;
            color: var(--light-bgcolor);
        }
    }

    
    @media (width < 500px) {
        .container { 
            padding: 1rem; 
            
            & figure { width: 120px; }
            & h1 { font-size: 2.5rem; }
            & h2 { font-size: 1.4rem; }
        }
    }
    @media (width < 430px) {
        .container figure { width: 100px; }
        .container h1 { font-size: 2rem; }
        .container h2 { font-size: 1.2rem; }
    }
</style>