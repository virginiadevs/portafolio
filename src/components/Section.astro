---
const { title } = Astro.props
---

<section>
    {title && <h2>{title}</h2>}
    <slot /> <!-- aquí va la información que recibe -->
</section>

<style>
    section {
        max-width: var(--width);
        margin: auto;
        margin-block: 24px 0;
        padding: 1rem;
    }

    h2 {
        margin-bottom: 8px;
        line-height: 1.5;
    }
</style>